{
  "name": "@veilo/element",
  "version": "0.6.0",
  "private": true,
  "description": "Web components for Veilo skeleton loaders and reveal animations, for plain HTML and any framework.",
  "type": "module",
  "sideEffects": [
    "./dist/define.*",
    "./dist/cdn.js"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./define": {
      "import": {
        "types": "./dist/define.d.mts",
        "default": "./dist/define.mjs"
      },
      "require": {
        "types": "./dist/define.d.cts",
        "default": "./dist/define.cjs"
      }
    },
    "./cdn.js": "./dist/cdn.js"
  },
  "jsdelivr": "./dist/cdn.js",
  "unpkg": "./dist/cdn.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check:entries": "node scripts/check-entries.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@lit/reactive-element": "^2.1.2",
    "@veilo/core": "workspace:*",
    "@veilo/presets": "workspace:*"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "5.1.0",
    "playwright": "1.64.1",
    "vite": "^8.3.5"
  }
}
