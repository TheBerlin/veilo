{
  "name": "@veilo/element",
  "version": "0.4.1",
  "private": true,
  "description": "Web components for Veilo skeleton loaders and reveal animations, for plain HTML and any framework.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@veilo/core": "workspace:*",
    "@veilo/presets": "workspace:*",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "5.1.0",
    "playwright": "1.64.1",
    "vite": "^8.3.5"
  }
}
