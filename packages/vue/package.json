{
  "name": "@veilo/vue",
  "version": "0.7.0",
  "private": true,
  "description": "Vue 3 components and a composable for Veilo skeleton loaders and reveal animations.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@veilo/core": "workspace:*",
    "@veilo/presets": "workspace:*"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "5.1.0",
    "@vue/server-renderer": "^3.5.45",
    "@vue/test-utils": "^2.4.6",
    "playwright": "1.64.1",
    "vite": "^8.3.5",
    "vue": "^3.5.13"
  }
}
