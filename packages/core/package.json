{
  "name": "@veilo/core",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./loader": {
      "import": {
        "types": "./dist/loader.d.mts",
        "default": "./dist/loader.mjs"
      },
      "require": {
        "types": "./dist/loader.d.cts",
        "default": "./dist/loader.cjs"
      }
    },
    "./settings.schema.json": "./settings.schema.json"
  },
  "files": [
    "dist",
    "settings.schema.json"
  ],
  "scripts": {
    "build": "tsdown",
    "generate:schema": "node scripts/generate-schema.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "check:entries": "node scripts/check-entries.mjs"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "playwright": "1.64.1"
  }
}
