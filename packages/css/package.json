{
  "name": "@veilo/css",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./skeleton.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./skeleton.css": "./skeleton.css"
  },
  "files": [
    "dist",
    "skeleton.css"
  ],
  "scripts": {
    "build": "tsdown",
    "generate:stylesheet": "node scripts/generate-stylesheet.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@veilo/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "lightningcss": "^1.33.0"
  }
}
