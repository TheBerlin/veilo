{
  "name": "@veilo/react",
  "version": "0.3.1",
  "private": true,
  "description": "React components and a hook for Veilo skeleton loaders and reveal animations.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "@veilo/core": "workspace:*",
    "@veilo/presets": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "5.1.0",
    "playwright": "1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.3.5"
  }
}
