{
  // Standalone on purpose: check.mjs copies this example out of the repo, so it must not extend
  // the repo's base config. Strict, as a careful user would set it.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "types": ["vite/client"]
  },
  "include": ["src"]
}
