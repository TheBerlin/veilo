{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["vitest.shared.ts", "tsdown.shared.ts", "tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": { "outputs": [] },
    "dev": { "cache": false, "persistent": true },
    "typecheck": { "outputs": [] },
    // Not cached: it reads packages/core, which Turbo would not count as this task's input.
    "check:layers": { "cache": false }
  }
}
