{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["vitest.shared.ts", "tsdown.shared.ts", "tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": { "cache": false, "persistent": true },
    // Packages read their dependencies' types from dist, so build those first.
    "typecheck": { "dependsOn": ["^build"], "outputs": [] },
    // Not cached: these read other packages, which Turbo would not count as their input.
    "lint": { "cache": false },
    "check:layers": { "cache": false }
  }
}
